# ── Database ──────────────────────────────────────────────────────────

# PostgreSQL connection string (libpq format). The default uses a Unix
# domain socket at /run/postgresql which is typical inside the Docker
# container.
DATABASE_URL=postgres://postgres@%2Frun%2Fpostgresql/rust_mcp

# Minimum number of connections kept alive in the database pool.
# Integer >= 0.
# DATABASE_MIN_CONNECTIONS=1

# Maximum number of connections in the database pool.
# Integer >= 1.
# DATABASE_MAX_CONNECTIONS=10

# Run SQL migrations automatically on startup.
# true | false
AUTO_MIGRATE=true

# ── HTTP / MCP transport ─────────────────────────────────────────────

# Socket address the HTTP server binds to. The default here uses
# 0.0.0.0 for Docker; the compiled-in default is 127.0.0.1:43173.
# Format: <ip>:<port>
MCP_HTTP_BIND=0.0.0.0:43173

# Interval in seconds between SSE keep-alive pings sent to connected
# MCP clients. Integer >= 1.
MCP_SSE_KEEP_ALIVE_SECS=15

# Delay in milliseconds the SSE "retry:" field tells clients to wait
# before reconnecting. Integer >= 0.
MCP_SSE_RETRY_MS=3000

# Reject /mcp POST requests that don't include an MCP-compliant Accept
# header. Set to true for strict protocol conformance testing.
# true | false
# MCP_STRICT_ACCEPT=false

# Maximum number of concurrent inbound HTTP requests the server will
# process simultaneously. Integer >= 1.
# MAX_CONCURRENT_REQUESTS=128

# ── crates.io integration ────────────────────────────────────────────

# Base URL for crates.io API calls. Override for testing with a mock
# server.
CRATES_IO_BASE_URL=https://crates.io

# User-Agent header sent with outbound crates.io requests.
# crates.io requires a descriptive User-Agent per their crawler policy.
CRATES_IO_USER_AGENT=rust-mcp/0.1.0-local-dev-machine

# HTTP timeout in seconds for outbound crates.io and OSV requests.
# Integer >= 1.
CRATES_IO_TIMEOUT_SECS=20

# Minimum delay in milliseconds between consecutive outbound crates.io
# requests (burst gate). crates.io crawler policy requires max 1 req/s.
# Integer >= 0.
# CRATES_IO_MIN_INTERVAL_MS=1000

# Maximum number of crates.io requests allowed within the rolling
# window. 0 = window rate limiting disabled.
# Integer >= 0.
# CRATES_IO_WINDOW_MAX_REQUESTS=60

# Duration in seconds of the rolling rate-limit window for crates.io.
# Integer >= 1.
# CRATES_IO_WINDOW_DURATION_SECS=120

# ── docs.rs integration ──────────────────────────────────────────────

# Base URL for docs.rs page fetches. Override for testing with a mock
# server.
# DOCS_RS_BASE_URL=https://docs.rs

# Minimum delay in milliseconds between consecutive outbound docs.rs
# requests (burst gate). Integer >= 0.
# DOCS_RS_MIN_INTERVAL_MS=1000

# Maximum number of docs.rs requests allowed within the rolling window.
# 0 = window rate limiting disabled. Integer >= 0.
# DOCS_RS_WINDOW_MAX_REQUESTS=60

# Duration in seconds of the rolling rate-limit window for docs.rs.
# Integer >= 1.
# DOCS_RS_WINDOW_DURATION_SECS=120

# ── OSV integration ──────────────────────────────────────────────────

# Base URL for OSV API calls. Override for testing with a mock server.
# OSV_BASE_URL=https://api.osv.dev

# Minimum delay in milliseconds between consecutive outbound OSV API
# requests (burst gate). Integer >= 0.
# OSV_MIN_INTERVAL_MS=1000

# Maximum number of OSV requests allowed within the rolling window.
# 0 = window rate limiting disabled. Integer >= 0.
# OSV_WINDOW_MAX_REQUESTS=60

# Duration in seconds of the rolling rate-limit window for OSV.
# Integer >= 1.
# OSV_WINDOW_DURATION_SECS=120

# ── Paths ─────────────────────────────────────────────────────────────

# Path to the cargo registry directory inside the container. The host's
# ~/.cargo/registry is typically bind-mounted here. The server reads
# .crate files and registry metadata from this location.
CARGO_REGISTRY_DIR=/cargo/registry

# Server data directory inside the container. Used for internal state,
# downloaded sources, and ephemeral data. Should be a persistent volume
# to survive container restarts.
MCP_DATA_DIR=/var/lib/rust-mcp

# Directory inside the container for on-demand crate source downloads
# from crates.io. Defaults to {MCP_DATA_DIR}/crate-sources.
# CRATE_SOURCE_CACHE_DIR=/var/lib/rust-mcp/crate-sources

# Optional path to a local clone of the RustSec advisory-db repository
# (https://github.com/rustsec/advisory-db). When set, the server
# cross-references local RustSec advisories during security syncs.
# Unset = RustSec DB sync disabled.
# RUSTSEC_DB_DIR=

# Optional directory containing pre-generated rustdoc JSON files.
# Unset = rustdoc JSON files are fetched from docs.rs on demand.
# RUSTDOC_JSON_DIR=

# Optional directory where tool JSON Schema artifacts are written on
# startup. Useful for exporting schemas for external consumers.
# Unset = no schema export.
# SCHEMA_EXPORT_DIR=

# ── Registry discovery & pre-warming ─────────────────────────────────

# Interval in seconds between periodic registry discovery scans that
# find new crates in CARGO_REGISTRY_DIR. 0 = disabled (startup only).
# Integer >= 0.
# REGISTRY_SCAN_INTERVAL_SECS=600

# Maximum number of new crate jobs to enqueue per discovery scan run.
# 0 = unlimited. Integer >= 0.
# REGISTRY_SCAN_BATCH_LIMIT=0

# Comma-separated list of crate names to index first at startup, before
# the general registry scan begins. Empty = no pre-warming.
# PRE_WARM_CRATES=

# Polling interval in milliseconds for the registry cache watcher.
# Monitors {CARGO_REGISTRY_DIR}/cache/ for new .crate files to trigger
# near-instant indexing of newly added crates. 0 = disabled.
# Integer >= 0.
# REGISTRY_CACHE_WATCH_INTERVAL_MS=1000

# ── Enrichment maintenance ───────────────────────────────────────────

# Interval in seconds between enrichment maintenance scans that enqueue
# rustdoc JSON enrichment jobs for unenriched crate versions.
# 0 = disabled after startup scan. Integer >= 0.
# ENRICHMENT_MAINTENANCE_INTERVAL_SECS=300

# Minimum seconds before retrying a previously failed rustdoc
# enrichment attempt. Acts as a cooldown to avoid hammering docs.rs for
# crates whose rustdoc JSON is unavailable. Integer >= 0.
# RUSTDOC_RETRY_COOLDOWN_SECS=86400

# ── Security advisory sync ─────────────────────────────────────────

# Interval in seconds between periodic security advisory syncs that
# query OSV and RustSec for vulnerability data. An initial scan runs at
# startup regardless. 0 = startup scan only, no recurring sync.
# Integer >= 0.
# SECURITY_SYNC_INTERVAL_SECS=86400

# Maximum number of crates to check per page during a security sync
# scan. Controls batch size for paging through indexed crates.
# Integer >= 1.
# SECURITY_SYNC_BATCH_SIZE=50

# ── Logging ───────────────────────────────────────────────────────────

# Tracing filter string (RUST_LOG style). Controls log verbosity per
# crate/module. See https://docs.rs/tracing-subscriber for syntax.
RUST_LOG=info,rust_mcp=debug,sqlx=warn,bollard=warn,reqwest=warn

# Log output format.
# pretty | json
LOG_FORMAT=pretty

# ── Docker / entrypoint only (not read by the server binary) ─────────

# Host port the Docker entrypoint maps the HTTP server to. Only used by
# the container entrypoint script, not by the server binary itself.
MCP_HTTP_PORT=43173

# Enable iptables-based outbound firewall in the container. Only
# domains in OUTBOUND_ALLOWLIST can be reached.
# true | false
OUTBOUND_FIREWALL=true

# Comma-separated list of domains allowed through the outbound
# firewall. Only effective when OUTBOUND_FIREWALL=true.
OUTBOUND_ALLOWLIST=crates.io,static.crates.io,docs.rs,api.osv.dev,api.github.com
