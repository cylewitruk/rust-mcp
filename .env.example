DATABASE_URL=postgres://postgres@%2Frun%2Fpostgresql/rust_mcp
MCP_HTTP_PORT=43173
MCP_HTTP_BIND=0.0.0.0:43173
MCP_TRANSPORT=http
MCP_SSE_KEEP_ALIVE_SECS=15
MCP_SSE_RETRY_MS=3000
CRATES_IO_BASE_URL=https://crates.io
CRATES_IO_USER_AGENT=rust-mcp/0.1.0-local-dev-machine
CRATES_IO_TIMEOUT_SECS=20
AUTO_MIGRATE=true
PROMETHEUS_BIND=0.0.0.0:9090
PROMETHEUS_PORT=9090

CARGO_REGISTRY_DIR=/cargo/registry
MCP_DATA_DIR=/var/lib/rust-mcp
RUSTSEC_DB_DIR=
SCHEMA_EXPORT_DIR=

OUTBOUND_FIREWALL=true
OUTBOUND_ALLOWLIST=crates.io,static.crates.io,docs.rs,api.osv.dev,api.github.com

RUST_LOG=info,rust_mcp=debug,sqlx=warn
LOG_FORMAT=pretty
