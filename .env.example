# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres@%2Frun%2Fpostgresql/rust_mcp
# DATABASE_MIN_CONNECTIONS=1
# DATABASE_MAX_CONNECTIONS=10
AUTO_MIGRATE=true

# ── HTTP / MCP transport ─────────────────────────────────────────────
MCP_HTTP_BIND=0.0.0.0:43173
MCP_SSE_KEEP_ALIVE_SECS=15
MCP_SSE_RETRY_MS=3000
# MCP_STRICT_ACCEPT=false
# MAX_CONCURRENT_REQUESTS=128

# ── crates.io integration ────────────────────────────────────────────
CRATES_IO_BASE_URL=https://crates.io
CRATES_IO_USER_AGENT=rust-mcp/0.1.0-local-dev-machine
CRATES_IO_TIMEOUT_SECS=20
# CRATES_IO_MIN_INTERVAL_MS=1000

# ── docs.rs integration ──────────────────────────────────────────────
# DOCS_RS_BASE_URL=https://docs.rs
# DOCS_RS_MIN_INTERVAL_MS=500

# ── OSV integration ──────────────────────────────────────────────────
# OSV_MIN_INTERVAL_MS=250

# ── Paths ─────────────────────────────────────────────────────────────
CARGO_REGISTRY_DIR=/cargo/registry
MCP_DATA_DIR=/var/lib/rust-mcp
# CRATE_SOURCE_CACHE_DIR=/var/lib/rust-mcp/crate-sources
# RUSTSEC_DB_DIR=
# RUSTDOC_JSON_DIR=
# SCHEMA_EXPORT_DIR=

# ── Registry discovery & pre-warming ─────────────────────────────────
# REGISTRY_SCAN_INTERVAL_SECS=600
# REGISTRY_SCAN_BATCH_LIMIT=0
# PRE_WARM_CRATES=
# REGISTRY_CACHE_WATCH_INTERVAL_MS=1000

# ── Enrichment maintenance ───────────────────────────────────────────
# ENRICHMENT_MAINTENANCE_INTERVAL_SECS=300
# RUSTDOC_RETRY_COOLDOWN_SECS=86400

# ── Logging ───────────────────────────────────────────────────────────
RUST_LOG=info,rust_mcp=debug,sqlx=warn,bollard=warn,reqwest=warn
LOG_FORMAT=pretty

# ── Docker / entrypoint only (not read by the server binary) ─────────
MCP_HTTP_PORT=43173
OUTBOUND_FIREWALL=true
OUTBOUND_ALLOWLIST=crates.io,static.crates.io,docs.rs,api.osv.dev,api.github.com
